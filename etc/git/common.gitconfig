[alias]
	a = add
	b = branch
	c = commit
	cm = commit -m
	d = diff
	ds = diff --staged
	f = fetch
	l = log
	lo = log --oneline
	m = merge
	p = push
	r = rebase
	s = status --short --branch
	sw = switch
	swc = switch --no-track -c
[branch]
	sort = -committerdate
[commit]
	verbose = true
[diff]
	algorithm = histogram
	colorMoved = true
	mnemonicPrefix = true
	renames = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
[push]
	default = simple
	autoSetupRemote = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[tag]
	sort = verions:refname
